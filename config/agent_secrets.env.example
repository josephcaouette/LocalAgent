# Optional authentication for Redis and Qdrant.
# To use it: copy this file to agent_secrets.env in this folder and set the values.
# Every client (pipeline, GUI, ingest worker, dashboard) reads agent_secrets.env through
# Z:\workspace\config.py. This folder is outside the workspace, so sandboxed code can't read it.
#
# The servers must be started with the same values (this needs a Redis/Qdrant restart):
#   Redis:  add  --requirepass <password>  to the redis command in Z:\docker\docker-compose.yml
#   Qdrant: add  QDRANT__SERVICE__API_KEY=<key>  under environment: for the qdrant service
#
# AGENT_REDIS_PASSWORD=change-me
# AGENT_QDRANT_API_KEY=change-me
